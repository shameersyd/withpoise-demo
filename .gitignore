# Local Python environment (1.5 GB)
venv/
__pycache__/
*.pyc

# MediaPipe model — the web app downloads this from Google's CDN at runtime
*.task

# Local HTTPS certs generated by serve.py — .self_signed_key.pem is a private key
*.pem

# macOS
.DS_Store

# Local agent/editor settings
.claude/

# Kept local — not part of the web app repo
mood_tracker.py
yoga_tracker.py

# The instructor video: 318 MB, well past what GitHub will take. See
# withpoise-demo/README.md, "Getting the video".
withpoise-demo/media/*.mp4

# Recorded practice sessions: a person's body, and nobody else's business.
recordings/
